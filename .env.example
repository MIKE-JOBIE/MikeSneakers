# Copy this file to .env and fill in real values.
# Never commit the real .env file to git or share it in chat.

# --- Required ---

# Long random string used to sign sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the built-in owner account (username is fixed as
# MichaelJobieMusa in app.py). The app will refuse to create/reset the
# owner account without this being set.
OWNER_PASSWORD=

# --- Recommended for production ---

# development | production
# In production: SECRET_KEY becomes mandatory, secure cookies are enforced.
FLASK_ENV=development

# Defaults to local SQLite if unset. Switch to Postgres once you're
# running 20-30 concurrent staff / large sales history, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/mikesneakers
DATABASE_URL=sqlite:///sneakers.db

# Comma-separated origin(s) allowed to open a Socket.IO connection to
# this app, e.g. https://mikesneakers.example.com
# Leave unset in dev (defaults to "*"); must be set explicitly in production.
SOCKETIO_ORIGINS=

# Only needed if you run more than one worker/process — points rate
# limiting at shared storage instead of in-memory per-process counters.
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=
